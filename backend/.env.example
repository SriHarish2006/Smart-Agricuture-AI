# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Get a free API key at https://openweathermap.org/api
WEATHER_API_KEY=f9738faccf4ff7776916782587d712be

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./agriculture.db

# Minimum confidence (0-1) required before a disease prediction is treated as reliable
DISEASE_CONFIDENCE_THRESHOLD=0.60
